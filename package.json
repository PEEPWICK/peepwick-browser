{
  "name": "peepwick-browser",
  "productName": "PEEPWICK Browser",
  "version": "0.1.0",
  "private": true,
  "description": "PEEPWICK Browser — a calm, private browser that guards your attention. First, we look.",
  "license": "GPL-3.0-only",
  "author": {
    "name": "PEEPWICK",
    "email": "322821078+1emircanturan@users.noreply.github.com"
  },
  "homepage": "https://github.com/PEEPWICK/peepwick-browser",
  "repository": {
    "type": "git",
    "url": "https://github.com/PEEPWICK/peepwick-browser.git"
  },
  "type": "module",
  "main": "out/main/index.js",
  "desktopName": "peepwick-browser.desktop",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "icons": "node scripts/icons.mjs",
    "dist": "npm run build && electron-builder --linux --publish never",
    "release": "npm run build && electron-builder --linux --publish always"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "2.20.1",
    "electron-chrome-extensions": "4.9.0",
    "electron-chrome-web-store": "0.13.0",
    "electron-updater": "6.8.9",
    "tldts": "7.4.19"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@mozilla/readability": "0.6.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/chrome": "0.3.6",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
