{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PEEPWICK Browser",
  "mainBinaryName": "peepwick-browser",
  "version": "../package.json",
  "identifier": "com.peepwick.browser",
  "build": {
    "beforeDevCommand": "npm run ui:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run ui:build",
    "frontendDist": "../dist-ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "shortDescription": "A calm, private browser that guards your attention.",
    "copyright": "Copyright © 2026 PEEPWICK",
    "license": "GPL-3.0-only",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
