{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PEEPWICK Browser",
  "mainBinaryName": "peepwick-browser",
  "version": "../package.json",
  "identifier": "com.peepwick.browser",
  "build": {
    "beforeDevCommand": "npm run ui:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run ui:build",
    "frontendDist": "../dist-ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "shortDescription": "A calm, private browser that guards your attention.",
    "copyright": "Copyright © 2026 PEEPWICK",
    "license": "GPL-3.0-only",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "publisher": "PEEPWICK",
    "homepage": "https://github.com/PEEPWICK/peepwick-browser",
    "longDescription": "PEEPWICK Browser blocks ads and trackers, keeps your spaces apart and stays out of the way of the pages you read. Built with Tauri and Rust on WebKitGTK.",
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "section": "web",
        "desktopTemplate": "linux/peepwick-browser.desktop",
        "recommends": [
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-libav"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU0ODFGREE1NDQyQTA1QjAKUldTd0JTcEVwZjJCNVArL3ZYTmljY2lZd1RxdGd3T05za1BLUXFVeU1iMDZONmtOQ3lPa0k4aDEK",
      "endpoints": [
        "https://raw.githubusercontent.com/PEEPWICK/peepwick-browser/updates/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
